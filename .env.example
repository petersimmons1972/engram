# Engram Configuration

# Embedding backend: "ollama" (local, free) or "openai" (premium)
# Default: ollama
ENGRAM_EMBEDDER=ollama

# Ollama base URL (used when ENGRAM_EMBEDDER=ollama)
# For system Ollama: http://localhost:11434
# For Docker Ollama: http://ollama:11434 (when running docker-compose with ollama service)
OLLAMA_URL=http://localhost:11434

# OpenAI API key (only needed if ENGRAM_EMBEDDER=openai)
# OPENAI_API_KEY=sk-...

# PostgreSQL password (used by docker-compose)
# Default: engram (change for production!)
POSTGRES_PASSWORD=engram

# Engram API key (optional; leave empty for no auth)
# Set this to require authentication on the SSE endpoint
# ENGRAM_API_KEY=...

# Engram port (used by docker-compose)
# Default: 8788
ENGRAM_PORT=8788
