# Engram Configuration
# Copy this file to .env and edit before running docker compose up -d.
#
# Mac M-series users: Ollama runs natively on macOS (Docker Desktop has no Metal GPU passthrough).
# Run: brew install ollama && ollama serve
# Then set: OLLAMA_URL=http://host.docker.internal:11434
# And comment out the ollama service in docker-compose.yml.

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-in-production

# ── Ollama ────────────────────────────────────────────────────────────────
# Default: Ollama runs as a Docker service (defined in docker-compose.yml)
OLLAMA_URL=http://ollama:11434

# Mac M-series (native Ollama): use this instead
# OLLAMA_URL=http://host.docker.internal:11434

# Embedding model (default: nomic-embed-text, 768 dimensions)
# ENGRAM_OLLAMA_MODEL=nomic-embed-text

# ── Embedding provider ────────────────────────────────────────────────────
# Auto-detect by default (tries Ollama first, then OpenAI, then BM25-only).
# Force a specific provider:
# ENGRAM_EMBEDDER=ollama    # Ollama (local, free, default)
# ENGRAM_EMBEDDER=openai    # OpenAI text-embedding-3-small (cloud, paid)
# ENGRAM_EMBEDDER=none      # BM25-only (no vectors, no external services)

# OpenAI API key (only needed if ENGRAM_EMBEDDER=openai):
# OPENAI_API_KEY=sk-...

# ── Engram server ─────────────────────────────────────────────────────────
ENGRAM_PORT=8788

# Require Bearer auth on the SSE endpoint. Strongly recommended if the
# server is accessible beyond localhost.
# ENGRAM_API_KEY=generate-a-strong-random-token-here
